FROM docker.m.daocloud.io/pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime
SHELL ["/bin/bash", "-c"]

LABEL maintainer="opencsg"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y curl git git-lfs dumb-init && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /etc/csghub
RUN pip config set global.index-url https://mirrors.aliyun.com/pypi/simple && \
    pip install --no-cache-dir "laya[serve]==0.3.22" csghub-sdk==0.7.10 huggingface-hub==0.36.2

COPY ./laya/ /etc/csghub/
RUN chmod +x /etc/csghub/*.sh

WORKDIR /workspace/
ENV HUGGINGFACE_HUB_CACHE=/workspace/ \
    HF_HUB_ENABLE_HF_TRANSFER=0

EXPOSE 8000
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/etc/csghub/serve.sh"]
