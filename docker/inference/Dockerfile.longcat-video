FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-devel

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
LABEL maintainer="opencsg"

ARG LONGCAT_COMMIT=6b3f4b8582a8bc3f20f795735f5383716c4ba794
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MAX_JOBS=8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    dumb-init \
    ffmpeg \
    git \
    libgl1 \
    libglib2.0-0 \
    libsndfile1 \
    ninja-build && \
    rm -rf /var/lib/apt/lists/*

RUN git clone https://github.com/meituan-longcat/LongCat-Video.git /opt/LongCat-Video && \
    cd /opt/LongCat-Video && \
    git checkout "${LONGCAT_COMMIT}" && \
    test "$(git rev-parse HEAD)" = "${LONGCAT_COMMIT}"

RUN pip install packaging psutil && \
    pip install --no-build-isolation flash-attn==2.7.4.post1 && \
    cd /opt/LongCat-Video && \
    sed -e '/^torch==/d' -e '/^flash-attn==/d' requirements.txt > /tmp/requirements.txt && \
    sed -e '/^libsndfile1==/d' -e '/^tritonserverclient==/d' requirements_avatar.txt > /tmp/requirements_avatar.txt && \
    pip install -r /tmp/requirements.txt -r /tmp/requirements_avatar.txt \
      "tritonclient[all]==2.64.0" fastapi "uvicorn[standard]" python-multipart csghub-sdk==0.7.10 minio oss2 && \
    python -c "import flash_attn, torch; assert torch.__version__.startswith('2.6.0'); assert torch.version.cuda.startswith('12.4')"

COPY ./longcat-video/ /etc/csghub/
RUN chmod +x /etc/csghub/serve.sh

WORKDIR /workspace
ENV PORT=8000 \
    GPU_NUM=1 \
    HF_HUB_ENABLE_HF_TRANSFER=0

EXPOSE 8000
ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["/etc/csghub/serve.sh"]
